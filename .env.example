# Postgres. On Vercel, use Neon/Supabase and paste the pooled connection string.
DATABASE_URL="postgresql://user:password@host:5432/syncup"

# Signs the session cookie. Any long random string — `openssl rand -base64 48`.
# Changing it signs everyone out.
SESSION_SECRET="change-me-to-something-long-and-random"

# The company timezone. Every day boundary, check-in deadline and attendance
# figure is read in this zone.
APP_TIMEZONE="Asia/Kolkata"

# Guards the scheduled reminder run. Leave it unset and the cron path stays
# closed — admins can still fire a pass by hand from Settings.
CRON_SECRET=""
