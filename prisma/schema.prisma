generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  CEO
}

enum EmploymentType {
  FULL_TIME
  INTERN
  FREELANCER
}

enum TaskStatus {
  PENDING
  PROGRESS
  COMPLETED
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum AttendanceStatus {
  PRESENT
  LEAVE
  HOLIDAY
  ABSENT
}

enum SessionKind {
  WORK
  BREAK
  IDLE
}

enum LeaveKind {
  SICK
  PLANNED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PasswordVisibility {
  COMPANY
  DEPARTMENT
  PEOPLE
}

enum McpScope {
  READ_ONLY
  READ_WRITE
}

enum OnboardingStepKind {
  /// A plain checkbox — the person self-attests it's done.
  CHECK
  /// A text field for their Slack member ID, so DMs work from day one without
  /// waiting on the email-lookup fallback.
  SLACK_ID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EMPLOYEE)
  department   String?
  title        String?
  employmentType EmploymentType @default(FULL_TIME)
  /// True right after account creation or an admin password reset — the login gate
  /// sends them to change it before anything else, so nobody keeps a password they
  /// didn't pick themselves.
  mustChangePassword Boolean @default(false)
  /// Running casual-leave balance. The monthly accrual caps it rather than resetting
  /// it, so unlike sick leave it carries for as long as it stays under the cap.
  casualLeaveBalance Int @default(0)
  /// Sick-leave balance. The monthly accrual replaces this outright rather than
  /// adding to it, so an unused day never carries into the next month.
  sickLeaveBalance   Int @default(0)
  /// "YYYY-MM" of the last month this person's leave was accrued, so the monthly
  /// pass is idempotent per person regardless of how many times it runs that month.
  lastLeaveAccrualMonth String?
  /// Per-person override for the check-in deadline, "HH:MM". Falls back to Settings.defaultCheckInBy.
  checkInBy    String?
  /// Last company-local day a "check in soon" Slack DM went out, so the 5-minute cron does not repeat itself.
  lastCheckInNudgeOn DateTime? @db.Date
  /// Per-person override for the minimum worked minutes to count as present. Falls back to Settings.minPresentMinutes.
  minPresentMinutes Int?
  /// Cached result of a Slack users.lookupByEmail call, so a DM doesn't re-resolve it every time.
  slackUserId  String?
  active       Boolean  @default(true)
  joinedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  attendance         Attendance[]
  planPoints         PlanPoint[]
  sessions           WorkSession[]
  reports            DailyReport[]
  createdTasks       Task[]               @relation("TaskCreator")
  assignedTasks      Task[]               @relation("TaskAssignee")
  leaveRequests      LeaveRequest[]       @relation("LeaveOwner")
  decidedLeave       LeaveRequest[]       @relation("LeaveDecider")
  balances           LeaveBalance[]
  onboardingProgress OnboardingProgress[]
  attachments        TaskAttachment[]
  createdApps        App[]
  createdPasswords   PasswordEntry[]      @relation("PasswordCreator")
  passwordShares     PasswordShare[]
  mcpTokens          McpToken[]           @relation("McpTokenOwner")
  oauthCodes         OAuthCode[]
  sessionAudits      SessionAuditLog[]    @relation("SessionAuditActor")

  @@index([active])
}

/// Single row, id = 1. Everything on the admin Settings page lives here.
model Settings {
  id Int @id @default(1)

  // Assignment cap
  assignmentCap Int @default(20)

  // End-of-day reports
  reportRequired Boolean @default(true)
  planFromTasks  Boolean @default(true)

  // The working week: ISO weekday numbers, 1 = Monday .. 7 = Sunday
  workingDays      Int[]  @default([1, 2, 3, 4, 5, 6])
  defaultCheckInBy String @default("09:30")

  // The managed department list — what People's dropdowns and Apps' scoping pick from.
  departments String[] @default([])

  // Onboarding
  onboardingEnforced Boolean @default(true)

  // Slack — incoming webhook (channel-only, the original path)
  slackWebhookUrl String?
  slackChannel    String?
  slackEnabled    Boolean @default(false)
  slackOnAssign   Boolean @default(true)
  slackOnStatus   Boolean @default(true)
  slackOnDeadline Boolean @default(true)

  // Slack — bot app (channel via chat.postMessage, plus personal DMs)
  /// xoxb-... bot token. Needs chat:write and users:read.email.
  slackBotToken   String?
  /// Channel ID (not name) the bot posts channel updates into, e.g. C0123456789.
  slackChannelId  String?
  slackBotEnabled Boolean @default(false)
  slackOnCheckin  Boolean @default(false)
  slackOnCheckout Boolean @default(false)
  slackOnEodSummary Boolean @default(false)
  /// Master switch for personal DMs. Off means the bot only ever posts to the channel.
  slackDmEnabled  Boolean @default(false)
  /// A task lands on them.
  slackDmOnAssign Boolean @default(true)
  /// End of day, on a working day, with no check-in recorded.
  slackDmOnAbsent Boolean @default(false)
  /// A running session got auto-closed for going quiet past the idle cut-off.
  slackDmOnInactive Boolean @default(false)
  /// A BREAK session went stale past staleBreakAlertMinutes — forgotten break, not work inactivity.
  slackDmOnStaleBreak Boolean @default(false)
  /// Today's plan, sent right after check-in.
  slackDmOnDailyPlan Boolean @default(false)
  /// 15 minutes before their own check-in time (09:30 → 09:15, 10:00 → 09:45).
  slackDmOnCheckInSoon Boolean @default(true)
  /// Mirrors the channel check-in post to the person themselves.
  slackDmOnCheckin Boolean @default(true)
  /// Mirrors the channel check-out post to the person themselves.
  slackDmOnCheckout Boolean @default(true)
  /// Mirrors a status move to whoever the task is assigned to.
  slackDmOnStatus Boolean @default(true)
  /// A personal list of just their own due/overdue tasks, instead of only the shared channel line.
  slackDmOnDeadline Boolean @default(true)

  // Google Sheets backup
  sheetsEnabled Boolean @default(false)
  /// service-account email from the downloaded JSON key.
  sheetsClientEmail String?
  /// PEM private key from the downloaded JSON key.
  sheetsPrivateKey  String?
  sheetsSpreadsheetId String?
  sheetsLastSyncAt    DateTime?
  sheetsLastSyncError String?

  // Heartbeat: minutes without a beat before the stretch is discarded as idle
  idleAfterMinutes Int @default(30)
  /// Minutes a BREAK session can sit stale before a Slack DM fires (independent of idleAfterMinutes).
  staleBreakAlertMinutes Int @default(30)

  // Presence
  /// Minutes of recorded work a day needs to count as present, company default.
  minPresentMinutes Int @default(240)

  updatedAt DateTime @updatedAt
}

model OnboardingStep {
  id          String             @id @default(cuid())
  title       String
  description String?
  order       Int                @default(0)
  kind        OnboardingStepKind @default(CHECK)

  progress OnboardingProgress[]
}

model OnboardingProgress {
  id          String   @id @default(cuid())
  userId      String
  stepId      String
  completedAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  step OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
}

/// One row per person per calendar day.
model Attendance {
  id         String           @id @default(cuid())
  userId     String
  date       DateTime         @db.Date
  checkInAt  DateTime?
  checkOutAt DateTime?
  /// The deadline that applied on the day, frozen so later settings changes don't rewrite history.
  checkInBy  String?
  late       Boolean          @default(false)
  status     AttendanceStatus @default(PRESENT)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

/// Work, break and idle stretches. Insights sums these; the heartbeat closes them.
model WorkSession {
  id          String      @id @default(cuid())
  userId      String
  date        DateTime    @db.Date
  kind        SessionKind @default(WORK)
  startedAt   DateTime
  endedAt     DateTime?
  /// Last heartbeat seen on this session. A stale beat means the tail is idle, not work.
  lastBeatAt  DateTime?
  /// Seconds reclassified as idle out of this session's span.
  idleSeconds Int         @default(0)
  /// Settings.idleAfterMinutes frozen at session creation, so a later settings
  /// change does not rewrite how already-elapsed silence is judged.
  idleCutoffMinutes Int @default(30)
  /// userId while this session is open, null once closed. Uniqueness is not
  /// declared here — Prisma db push treats a new unique constraint as data
  /// loss and would fail the Vercel build. `ensureOpenSessionIndex` creates
  /// UNIQUE (openUserId) and UNIQUE (userId) WHERE endedAt IS NULL at boot.
  openUserId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date])
  @@index([endedAt])
}

/// Admin edits and merges of work sessions. A reason is required on every write.
model SessionAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  reason    String
  userId    String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  actor User @relation("SessionAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actorId])
}

/// A point on someone's plan for the day. Unfinished points carry to the next working day.
model PlanPoint {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date
  title  String
  done   Boolean  @default(false)
  doneAt DateTime?
  order  Int      @default(0)
  /// Set when the point was auto-created from an assigned task.
  taskId String?
  /// The day this point first appeared, kept across carry-overs.
  originDate DateTime? @db.Date
  /// A point removed by hand stays removed for that day only.
  dismissed  Boolean   @default(false)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  detail      String?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?  @db.Date
  assigneeId  String
  creatorId   String
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  /// Last day a deadline reminder went out, so the daily pass doesn't repeat itself.
  lastRemindedOn DateTime? @db.Date

  assignee    User             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator     User             @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  points      PlanPoint[]
  attachments TaskAttachment[]

  @@index([assigneeId, status])
  @@index([dueDate])
}

/// A file or image on a task. Stored as bytes in the same database rather than a
/// separate paid storage service — fine at the size a team task tool sees, capped
/// per file so it stays that way.
model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedById String
  createdAt  DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model DailyReport {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  /// The only free text anyone types. The rest is composed from the day's real data.
  summary     String
  submittedAt DateTime @default(now())

  // Frozen at filing time so the report reads the same a year later.
  minutesWorked  Int @default(0)
  minutesBreak   Int @default(0)
  minutesIdle    Int @default(0)
  pointsDone     Int @default(0)
  pointsTotal    Int @default(0)
  tasksCompleted Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model LeaveRequest {
  id        String      @id @default(cuid())
  userId    String
  kind      LeaveKind
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  days      Int
  reason    String?
  status    LeaveStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  user    User  @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)
  decider User? @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model LeaveBalance {
  id          String @id @default(cuid())
  userId      String
  year        Int
  sickTotal   Int    @default(12)
  sickUsed    Int    @default(0)
  plannedTotal Int   @default(12)
  plannedUsed  Int   @default(0)
  carried      Int   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String

  @@index([date])
}

/// Bearer tokens for the MCP endpoint. Shown once, stored only as a hash.
model McpToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  /// First characters of the token, so a row is recognisable in the list.
  prefix     String
  /// READ_ONLY can only call the query tools. READ_WRITE can also assign tasks,
  /// change status and decide leave — never delete a person or reset a password.
  scope      McpScope  @default(READ_ONLY)
  /// The admin this token was minted for. Write tools attribute their actions
  /// (task creator, leave decider) to this person.
  createdById String?
  createdBy   User?     @relation("McpTokenOwner", fields: [createdById], references: [id], onDelete: SetNull)
  /// Set when this token was issued through the OAuth flow (e.g. Claude's
  /// Connectors screen) rather than minted by hand in Settings.
  oauthClientId String?
  oauthClient   OAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

/// An OAuth client registered dynamically (RFC 7591) — one row per app that's
/// ever asked to connect, e.g. Claude. Public client only: PKCE stands in for
/// a client secret, since a secret has nowhere safe to live in a client like
/// Claude's that runs in the browser or on someone else's server.
model OAuthClient {
  id           String   @id @default(cuid())
  name         String?
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  tokens McpToken[]
}

/// A one-time authorization code, minted after a person logs in to Syncup and
/// clicks Allow, exchanged at /oauth/token for a real access token. Five
/// minutes is plenty — the exchange happens in the same round trip.
model OAuthCode {
  /// A high-entropy random string minted in application code (lib/oauth.js),
  /// not a cuid — this is a short-lived bearer secret, not just a row id.
  code          String    @id
  clientId      String
  userId        String
  redirectUri   String
  /// PKCE (RFC 7636) — base64url(SHA-256(code_verifier)) from /oauth/authorize,
  /// checked against the code_verifier the client presents at /oauth/token.
  codeChallenge String
  scope         McpScope
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// A shortcut shown on the Apps page — company-wide, or scoped to one department.
/// No real integrations behind these; admins fill in whatever links their team needs.
model App {
  id          String   @id @default(cuid())
  name        String
  description String?
  url         String?
  icon        String   @default("◆")
  /// Null means every department sees it.
  department  String?
  order       Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([department])
}

/// One shared credential. The secret is encrypted at rest; who can see it is
/// controlled by visibility plus the explicit shares below.
model PasswordEntry {
  id         String             @id @default(cuid())
  title      String
  username   String?
  /// AES-256-GCM ciphertext: iv + authTag + encrypted bytes, see lib/crypto.js.
  secret     Bytes
  url        String?
  notes      String?
  visibility PasswordVisibility @default(PEOPLE)
  /// Used when visibility = DEPARTMENT.
  department String?
  createdById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  createdBy User            @relation("PasswordCreator", fields: [createdById], references: [id], onDelete: Cascade)
  shares    PasswordShare[]

  @@index([visibility, department])
}

/// A specific person granted access to one entry, on top of whatever visibility gives them.
model PasswordShare {
  id        String   @id @default(cuid())
  passwordId String
  userId    String
  createdAt DateTime @default(now())

  password PasswordEntry @relation(fields: [passwordId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([passwordId, userId])
}
